async function createNewPost() {
    const newPostData = {
        title: 'Internship Task Completed',
        body: 'Successfully learned Async JS and REST APIs!',
        userId: 1
    };

    try {
        const response = await fetch('https://jsonplaceholder.typicode.com/posts', {
            method: 'POST', // Specifying the HTTP Verb
            body: JSON.stringify(newPostData), // Converting JS object to JSON string
            headers: {
                'Content-type': 'application/json; charset=UTF-8',
            },
        });

        if (!response.ok) throw new Error("Failed to post data");

        const result = await response.json();
        console.log("Success! Server responded with:", result);
        alert("Post created successfully! Check your console.");
    } catch (error) {
        console.error("Post Error:", error);
    }
}
