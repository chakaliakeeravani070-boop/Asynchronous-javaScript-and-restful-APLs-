
const fetchBtn = document.getElementById('fetch-btn');
const postsContainer = document.getElementById('posts-container');

// Asynchronous function to call the REST API
async function getPosts() {
    try {
        postsContainer.innerHTML = "<p>Loading data...</p>";
        
        // 1. Send HTTP GET Request
        const response = await fetch('https://jsonplaceholder.typicode.com/posts?_limit=5');
        
        // 2. Check if the response status is successful (status 200-299)
        if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
        }
        
        // 3. Convert raw response stream to a readable JSON object
        const posts = await response.json();
        
        // 4. Update the UI DOM with data
        displayPosts(posts);

    } catch (error) {
        // Handle network errors or broken APIs gracefully
        console.error("Error fetching data:", error);
        postsContainer.innerHTML = `<p style="color: red;">Failed to load data: ${error.message}</p>`;
    }
}

// Helper function to render data onto the page
function displayPosts(posts) {
    postsContainer.innerHTML = ""; // Clear loading message
    posts.forEach(post => {
        const postElement = document.createElement('div');
        postElement.innerHTML = `
            <h3>${post.title}</h3>
            <p>${post.body}</p>
            <hr />
        `;
        postsContainer.appendChild(postElement);
    });
}

// Event Listener to trigger the Async process
fetchBtn.addEventListener('click', getPosts);
